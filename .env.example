# telegramCode 2.0 — forum-supergroup mode.
#
# Copy this file to `.env`, fill the required vars, then `yarn dev` or
# `yarn build && yarn start`. For docker compose use `examples/docker-compose.yml`
# and the per-instance prefix scheme (`PET_*` / `WORK_*`).
#
# When installed globally as `telegramCode` (via `npm i -g .`), env is loaded
# from two locations:
#   1. ~/.config/telegram-code/.env  (base — fill in once, used everywhere)
#   2. $PWD/.env                     (override — per-project tweaks)
# WORK_ROOT defaults to $PWD if unset, so `cd ~/projects && telegramCode` works
# out of the box.

# ── Required ────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather → /newbot → ...
TELEGRAM_BOT_TOKEN=

# Access control: there is NO user allow-list. Whoever is a creator or
# administrator of the served forum group may drive the bot (read live from
# Telegram, cached 1h). Promote someone in the group to grant access; demote to
# revoke. The bot must be a group admin itself (it already needs that to create
# topics and pin messages).

# Chat id of the forum-supergroup the bot listens to (negative number, usually
# starts with -100...). Two ways to obtain:
#   a) After the bot is added to the group, `/whoami` in any topic prints it.
#   b) Forward any message from the group to @JsonDumpBot — `chat.id`.
ALLOWED_GROUP_ID=

# Parent directory containing your project subfolders. Each forum thread
# binds to one subdir under WORK_ROOT (e.g. WORK_ROOT=/home/user/src,
# thread "overview" → cwd /home/user/src/overview). The directory must exist.
# When started via the `telegramCode` wrapper from any directory, this
# defaults to $PWD if unset.
WORK_ROOT=

# ── Optional ────────────────────────────────────────────────────────────────

# Where the bot keeps state.json, mcp.json, tmp/ and logs. Default:
# ~/.telegramCode. **Required to be distinct** when running two bots on the
# same host under the same linux user (otherwise they corrupt each other's
# state.json). See plan §10.7.
# DATA_DIR=/home/user/.telegramCode/mybot

# Default agent backend when a thread has no `setThreadAdapter` choice yet.
# Values: claude | opencode. Default: claude.
# DEFAULT_AGENT=claude

# User-facing language: ru | en. Default: ru.
# BOT_LANG=ru

# OpenCode HTTP server URL. Default http://localhost:4096. If you run two
# bots on the same host, the second must use a different port (e.g. 4097)
# — otherwise both fight for the same opencode-serve process. Plan §13.8.
# OPENCODE_URL=http://localhost:4096
# OPENCODE_PASSWORD=
# OPENCODE_USERNAME=opencode
# OPENCODE_ALLOW_REMOTE=1

# Custom opencode binary path (only if you've built a fork locally).
# OPENCODE_BIN=/path/to/opencode

# Custom Claude binary path (useful with nvm/asdf/systemd PATH differences).
# CLAUDE_BIN=/path/to/claude

# Debug / bot-owned MCP plumbing. SCHEDULER_MCP_PORT must differ from the
# OPENCODE_URL port in the same bot process/container.
# CLAUDE_SCRAPE_DEBUG=1
# SCHEDULER_MCP_PORT=4097

# Whisper provider for voice-message transcription. Either of these enables
# voice. If both are present, Groq is preferred (faster + free tier).
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Anthropic key for direct Anthropic API access from MCP servers etc.
# Claude CLI authenticates separately via `claude login`, so this is
# usually NOT required for the bot itself.
# ANTHROPIC_API_KEY=
