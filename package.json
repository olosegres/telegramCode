{
  "name": "telegram-code",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "author": "Sergei Solo",
  "description": "Telegram forum-supergroup bot for Claude Code / OpenCode — one topic per task, isolated sessions, per-thread MCP",
  "main": "dist/cli.js",
  "bin": {
    "telegramCode": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/index.js",
    "build:watch": "tsc -w",
    "start": "node dist/cli.js",
    "dev": "tsx watch src/cli.ts",
    "hot": "node dist/cli.js hot",
    "install-link": "yarn install && yarn build && npm link",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./src/__tests__/globalTestSetup.ts --test 'src/__tests__/**/*.test.ts'",
    "claude": "UID=$(id -u) GID=$(id -g) docker compose run --rm claude"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "croner": "^10.0.1",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.5",
    "node-pty": "^1.0.0",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@4.9.2"
}
